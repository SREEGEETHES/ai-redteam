# AI Red Team Configuration

# Application
APP_NAME=AI Red Team
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# API Server
API_HOST=127.0.0.1
API_PORT=8080

# Database
DATABASE_URL=sqlite:///./data/redteam.db

# Target Authorization (comma-separated patterns)
# Default: only localhost
ALLOWED_TARGETS=http://localhost:*,http://127.0.0.1:*
REQUIRE_EXPLICIT_AUTHORIZATION=true

# Scan Budgets
MAX_REQUESTS_PER_SCAN=100
MAX_TOKENS_PER_SCAN=50000
MAX_RUNTIME_SECONDS=300
MAX_TOOL_CALLS_PER_SCAN=50

# LLM Providers (optional)
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Taxonomy
TAXONOMY_VERSION=owasp-llm-2026